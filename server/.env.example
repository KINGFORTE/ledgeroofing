NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://ledgeroofing:change-this@localhost:5432/ledgeroofing
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
FRONTEND_ORIGIN=http://localhost:5173,https://ledgeroofing.org,https://www.ledgeroofing.org
UPLOAD_DIR=./uploads
CONTACT_TO_EMAIL=your-inbox@example.com
RESEND_API_KEY=your-resend-api-key
MAIL_FROM=staffmail@ledgeroofing.org
MAIL_FROM_NAME=Ledge Roofing Workspace
ATTENDANCE_TIME_ZONE=Africa/Lagos

# Optional browser push (keep private keys on the server only)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ledgeroofing.org

# Optional TURN credentials for meetings
TURN_HOST=api.ledgeroofing.org
TURN_PORT=3478
TURN_SECRET=

# FCM for closed-app call rings and alerts (never expose the service account)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_PATH=/secure/path/fcm-service-account.json

# Public API origin used in emails and download links
API_PUBLIC_ORIGIN=https://api.ledgeroofing.org

# Database TLS. Leave unset for local PostgreSQL.
# For hosted PostgreSQL, use PGSSL=require. Certificate verification is always on.
# If the provider uses a private CA, point PGSSL_CA at the CA certificate file.
# PGSSL=require
# PGSSL_CA=/etc/ssl/certs/provider-ca.pem

# Security notes:
# - JWT_SECRET must be long, random, and unique per environment.
# - Never commit .env files, private keys, or service account JSON.
# - Run `npm run migrate` before starting the API after upgrading.
# - Access tokens last 15 minutes; refresh tokens last 7 days and rotate on use.
